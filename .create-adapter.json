    "releaseScript": "yes",
    "devServer": "local",
    "indentation": "Space (4)",
    "quotes": "single",
    "authorName": "DutchmanNL",
    "authorGithub": "DrozmotiX",
    "authorEmail": "rdrozda86@gmail.com",
    "gitRemoteProtocol": "SSH",
    "gitCommit": "no",
